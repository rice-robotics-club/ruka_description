<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">
  <!-- Generated by scripts/urdf_to_xacro.py from robot.urdf. Do not edit by hand: re-run the Update URDF workflow (or the script) instead. -->
  <xacro:arg name="tf_prefix" default="" />
  <xacro:include filename="robot_macro.xacro" />
  <!-- Dummy root link: keeps the robot's first link from being the URDF root. -->
  <link name="world" />
  <xacro:robot tf_prefix="$(arg tf_prefix)" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:robot>
</robot>
